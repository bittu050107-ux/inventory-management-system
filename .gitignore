# ─────────────────────────────────────────────────────────────
# Git Ignore Rules - Inventory Management System
# ─────────────────────────────────────────────────────────────

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/

# ─── Pytest / Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ─── SQLite local database (dev only) ─────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Node / React Frontend ────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ─── Docker ───────────────────────────────────────────────────
*.dockerignore

# ─── IDEs & OS ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db
desktop.ini

# ─── Alembic (migration files managed separately) ─────────────
alembic/versions/*.py
